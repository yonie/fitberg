# ─── Fitberg configuration ────────────────────────────────────────────────────
# Copy to `.env` and edit. Everything here has a sane default except SESSION_SECRET.

# Where the server listens (inside the container)
PORT=8710
HOST=0.0.0.0

# Data root. Everything durable lives here — back THIS up and you have lost nothing.
# This value is for running Fitberg directly with Node. Under Docker Compose it is
# overridden to /data, which is where the volume is mounted.
#   $DATA_DIR/originals/  content-addressed, never-modified source files  <- the important one
#   $DATA_DIR/fitberg.db  derived cache, rebuildable with `npm run fitberg -- reindex`
DATA_DIR=./data

# Random string. Generate with: openssl rand -hex 32
# If unset, a random one is generated at boot and all sessions drop on restart.
SESSION_SECRET=

# Set to 1 to skip login entirely (only do this behind a VPN / trusted LAN).
FITBERG_OPEN_ACCESS=0

# ─── Local AI (optional) ──────────────────────────────────────────────────────
# Ollama endpoint. On Linux with host-networked Ollama, use http://172.17.0.1:11434
OLLAMA_URL=http://host.docker.internal:11434
# Any model your Ollama host serves. You can also set this on the Settings page,
# which lists whatever the host has installed — no need to edit this file.
OLLAMA_MODEL=llama3.2
# Leave blank to disable AI features entirely.
OLLAMA_ENABLED=1

# ─── Maps ─────────────────────────────────────────────────────────────────────
# Basemap style. Default is a free, key-less OSM raster style built in-app.
# For vector maps, point at a MapTiler/Stadia style URL or your own tileserver.
MAP_STYLE_URL=
# Terrain DEM tiles for the 3D flyover. Default: free AWS open terrain tiles.
# Self-hosters can serve Mapterhorn PMTiles instead. Encoding must match.
TERRAIN_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
TERRAIN_ENCODING=terrarium
TERRAIN_MAXZOOM=13

# ─── COROS sync (optional) ─────────────────────────────────────────────────────
# The official COROS MCP endpoint. No shared credentials: Fitberg registers its own
# OAuth client at connect time. The regional standalone URLs (mcpeu/mcpus/mcpcn
# .coros.com/mcp) can be used if the redirecting main URL misbehaves.
COROS_MCP_URL=https://mcp.coros.com/mcp
# Set to 0 to disable the background daily sync; "Sync now" still works.
COROS_AUTO_SYNC=1

# Public URL of this instance. Used only in the startup banner.
PUBLIC_URL=http://localhost:8710
