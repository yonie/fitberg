{
  "name": "fitberg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted fitness data hub. Your data, your cloud, forever.",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "comment:engines": "Node >=24 is recommended and needs no native modules (uses built-in node:sqlite). On Node 20/22 install the optional better-sqlite3 fallback.",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "install:all": "npm install && npm --prefix web install",
    "fitberg": "node server/cli.js",
    "reindex": "node server/cli.js reindex",
    "seed": "node test/seed.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@garmin/fitsdk": "^21.208.0",
    "fastify": "^5.10.0",
    "sax": "^1.4.1",
    "yauzl": "^3.2.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.1"
  }
}
